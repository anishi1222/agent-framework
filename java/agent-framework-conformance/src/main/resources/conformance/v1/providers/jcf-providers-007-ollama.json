{
  "schemaVersion": 1,
  "caseId": "JCF-PROVIDERS-007",
  "kind": "contract",
  "description": "Ollama native chat preserves framework text, inline image, tool, thinking, usage, NDJSON, error, and cancellation semantics.",
  "input": {
    "request": {
      "messages": [{"role": "user", "contents": [{"kind": "text", "text": "hello"}]}],
      "tools": [{"name": "lookup"}],
      "stream": true
    },
    "provider": "ollama"
  },
  "expected": {
    "requestRoleOrder": ["user"],
    "toolNames": ["lookup"],
    "finiteResponseMapped": true,
    "streamingUpdatesAggregate": true,
    "fragmentedToolCallsAssembled": true,
    "usageFinishIdentifiersMapped": true,
    "typedErrorsPreserved": true,
    "cancellationPropagated": true,
    "providerTypesInSharedApi": false,
    "capabilities": {"text": true, "images": true, "documents": false, "audio": false, "structuredOutput": true},
    "limitations": ["developer role", "remote image URI", "forced tool choice"]
  }
}
