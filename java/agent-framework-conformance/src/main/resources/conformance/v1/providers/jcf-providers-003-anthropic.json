{
  "schemaVersion": 1,
  "caseId": "JCF-PROVIDERS-003",
  "kind": "contract",
  "description": "Anthropic Messages preserves framework text, tool, usage, streaming, error, and cancellation semantics.",
  "input": {
    "request": {
      "messages": [{"role": "user", "contents": [{"kind": "text", "text": "hello"}]}],
      "tools": [{"name": "lookup"}],
      "stream": true
    },
    "provider": "anthropic"
  },
  "expected": {
    "requestRoleOrder": ["user"],
    "toolNames": ["lookup"],
    "finiteResponseMapped": true,
    "streamingUpdatesAggregate": true,
    "fragmentedToolCallsAssembled": true,
    "usageFinishIdentifiersMapped": true,
    "typedErrorsPreserved": true,
    "cancellationPropagated": true,
    "providerTypesInSharedApi": false,
    "capabilities": {"text": true, "images": true, "documents": true, "audio": false, "structuredOutput": true},
    "limitations": ["developer role", "audio input", "Claude Agent SDK"]
  }
}
