{
  "schemaVersion": 1,
  "caseId": "JCF-SESSIONS-002",
  "kind": "session-snapshot",
  "description": "Session writes use optimistic revisions and preserve the prior snapshot on conflict.",
  "envelope": {
    "format": "agent-framework-java-state",
    "documentKind": "agent-session",
    "payloadVersion": 1,
    "payload": {"sessionId": "session-cas", "state": {"value": "first"}}
  },
  "operations": [
    {"operation": "save", "expectedRevision": 0, "outcome": "success", "returnedRevision": 1},
    {"operation": "save", "expectedRevision": 0, "value": "stale", "outcome": "storageConflict"},
    {"operation": "load", "outcome": "success"}
  ],
  "expected": {
    "loadedRevision": 1,
    "loadedValue": "first",
    "lastWriterWins": false,
    "failedWritePreservesSnapshot": true
  }
}
