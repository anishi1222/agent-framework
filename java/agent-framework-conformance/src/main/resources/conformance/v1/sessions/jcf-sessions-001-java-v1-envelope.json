    "payloadVersion": 1,
    "payload": {
      "sessionId": "session-001",
      "messages": [{"role": "user", "contents": [{"kind": "text", "text": "hello"}]}],
      "state": {"turn": 1}
    }
  },
  "operations": [
    {"operation": "decode", "readerVersion": 1},
    {"operation": "encode", "writerVersion": 1}
  ],
  "expected": {
    "roundTripWithinJavaV1": true,
    "observableSessionId": "session-001",
    "observableMessageText": "hello",
    "crossLanguageWireCompatible": false,
    "unknownDocumentKindRejected": true,
    "unknownPayloadVersionRejected": true
  }
